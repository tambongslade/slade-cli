import { and, or, asc, desc, eq, ne, gt, gte, lt, lte, inArray, notInArray, ilike, isNull, isNotNull, count, type SQL } from "drizzle-orm";
import type { AnyPgColumn, PgTable } from "drizzle-orm/pg-core";
import { DrizzleDb } from "@shared/database/drizzle.provider";

export type FilterOperator =
  | "eq"
  | "ne"
  | "gt"
  | "gte"
  | "lt"
  | "lte"
  | "in"
  | "nin"
  | "like"
  | "ilike"
  | "between"
  | "isNull"
  | "isNotNull";

export interface FilterCondition {
  field: string;
  operator: FilterOperator;
  value?: any;
}

export interface QueryOptions {
  page?: number;
  limit?: number;
  sortBy?: string;
  sortOrder?: "ASC" | "DESC";
  search?: string;
  searchFields?: string[];
  filters?: Record<string, any>;
}

/**
 * Map of filterable field name -> Drizzle column, e.g.
 * { id: usersTable.id, email: usersTable.email }
 */
export type FilterColumnMap = Record<string, AnyPgColumn>;

/**
 * Parse filter parameters from query string
 * Supports format: field__operator=value (e.g., age__gte=18, name__like=john)
 */
export function parseFilters(query: Record<string, any>): FilterCondition[] {
  const conditions: FilterCondition[] = [];
  const operatorMap: Record<string, FilterOperator> = {
    eq: "eq",
    ne: "ne",
    gt: "gt",
    gte: "gte",
    lt: "lt",
    lte: "lte",
    in: "in",
    nin: "nin",
    like: "like",
    ilike: "ilike",
    between: "between",
    isNull: "isNull",
    isNotNull: "isNotNull",
  };

  for (const [key, value] of Object.entries(query)) {
    if (value === undefined || value === null || value === "") continue;

    // Skip pagination and sort params
    if (["page", "limit", "sortBy", "sortOrder", "search", "searchFields"].includes(key)) {
      continue;
    }

    // Check for operator suffix (field__operator)
    const parts = key.split("__");
    const field = parts[0];
    const operatorKey = parts[1] || "eq";
    const operator = operatorMap[operatorKey] || "eq";

    conditions.push({ field, operator, value });
  }

  return conditions;
}

/**
 * Build a drizzle-orm WHERE condition from a list of filter conditions.
 * `columns` maps each filterable field name to its Drizzle column — fields
 * that aren't in the map are ignored (nothing is applied).
 */
export function buildFilterConditions(
  conditions: FilterCondition[],
  columns: FilterColumnMap
): SQL | undefined {
  const clauses: SQL[] = [];

  for (const condition of conditions) {
    const column = columns[condition.field];
    if (!column) continue;

    const { operator, value } = condition;

    switch (operator) {
      case "eq":
        clauses.push(eq(column, value));
        break;
      case "ne":
        clauses.push(ne(column, value));
        break;
      case "gt":
        clauses.push(gt(column, value));
        break;
      case "gte":
        clauses.push(gte(column, value));
        break;
      case "lt":
        clauses.push(lt(column, value));
        break;
      case "lte":
        clauses.push(lte(column, value));
        break;
      case "in": {
        const inValues = Array.isArray(value) ? value : String(value).split(",");
        clauses.push(inArray(column, inValues));
        break;
      }
      case "nin": {
        const ninValues = Array.isArray(value) ? value : String(value).split(",");
        clauses.push(notInArray(column, ninValues));
        break;
      }
      case "like":
        clauses.push(ilike(column, `%${value}%`));
        break;
      case "ilike":
        clauses.push(ilike(column, `%${value}%`));
        break;
      case "between": {
        const [min, max] = Array.isArray(value) ? value : String(value).split(",");
        clauses.push(and(gte(column, min), lte(column, max))!);
        break;
      }
      case "isNull":
        clauses.push(isNull(column));
        break;
      case "isNotNull":
        clauses.push(isNotNull(column));
        break;
    }
  }

  return clauses.length > 0 ? and(...clauses) : undefined;
}

/**
 * Build an OR condition matching `search` against any of `searchFields`
 * (case-insensitive substring match).
 */
export function buildSearchCondition(
  search: string,
  searchFields: string[],
  columns: FilterColumnMap
): SQL | undefined {
  if (!search || searchFields.length === 0) return undefined;

  const clauses = searchFields
    .map((field) => columns[field])
    .filter((column): column is AnyPgColumn => Boolean(column))
    .map((column) => ilike(column, `%${search}%`));

  return clauses.length > 0 ? or(...clauses) : undefined;
}

/**
 * Resolve the ORDER BY clause for a query, falling back to `defaultSortBy`
 * (or the first available column) when `options.sortBy` isn't filterable.
 */
export function buildOrderBy(
  options: QueryOptions,
  columns: FilterColumnMap,
  defaultSortBy = "createdAt"
): SQL | undefined {
  const { sortBy = defaultSortBy, sortOrder = "DESC" } = options;
  const column = columns[sortBy] ?? columns[defaultSortBy];
  if (!column) return undefined;

  return sortOrder === "ASC" ? asc(column) : desc(column);
}

/**
 * Build complete query with filters, search, and pagination, and execute it
 * against a Drizzle table.
 */
export async function executeFilteredQuery<TRow extends Record<string, unknown>>(
  db: DrizzleDb,
  table: PgTable,
  columns: FilterColumnMap,
  options: QueryOptions,
  defaultSearchFields: string[] = []
): Promise<[TRow[], number]> {
  const { page = 1, limit = 10 } = options;

  const conditions = options.filters ? parseFilters(options.filters) : [];
  const filterWhere = buildFilterConditions(conditions, columns);

  const searchFields = options.searchFields || defaultSearchFields;
  const searchWhere = options.search
    ? buildSearchCondition(options.search, searchFields, columns)
    : undefined;

  const where =
    filterWhere && searchWhere
      ? and(filterWhere, searchWhere)
      : (filterWhere ?? searchWhere);

  const orderBy = buildOrderBy(options, columns);

  const rowsQuery = db.select().from(table);
  const filteredRows = where ? rowsQuery.where(where) : rowsQuery;
  const orderedRows = orderBy ? filteredRows.orderBy(orderBy) : filteredRows;
  const pagedRows = orderedRows.limit(limit).offset((page - 1) * limit);

  const countQuery = db.select({ value: count() }).from(table);
  const filteredCount = where ? countQuery.where(where) : countQuery;

  const [items, [countResult]] = await Promise.all([pagedRows, filteredCount]);

  return [items as unknown as TRow[], countResult?.value ?? 0];
}
